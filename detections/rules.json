{
  "schema_version": "1.0",
  "rules": [
    {"id":"AGENTIR-001","title":"Shared human credential used by agent","severity":"high","conditions":[{"field":"agent.security.identity.type","op":"eq","value":"human_shared"}],"mitre_atlas":["Credential Access"],"owasp_agentic":["Identity and Privilege Abuse"]},
    {"id":"AGENTIR-002","title":"Token audience mismatch","severity":"high","conditions":[{"field":"agent.security.token.audience_match","op":"eq","value":false}],"mitre_atlas":["Credential Access"],"owasp_agentic":["Identity and Privilege Abuse"]},
    {"id":"AGENTIR-003","title":"Expired credential accepted","severity":"critical","conditions":[{"field":"agent.security.token.expired","op":"eq","value":true},{"field":"agent.security.authorization.decision","op":"eq","value":"allow"}],"mitre_atlas":["Credential Access"],"owasp_agentic":["Identity and Privilege Abuse"]},
    {"id":"AGENTIR-004","title":"Revoked delegation remains active","severity":"critical","conditions":[{"field":"agent.security.delegation.status","op":"eq","value":"revoked"},{"field":"agent.security.authorization.decision","op":"eq","value":"allow"}],"mitre_atlas":["Persistence"],"owasp_agentic":["Identity and Privilege Abuse"]},
    {"id":"AGENTIR-005","title":"Child agent exceeds parent authority","severity":"critical","conditions":[{"field":"agent.security.delegation.amplification","op":"eq","value":true}],"mitre_atlas":["Privilege Escalation"],"owasp_agentic":["Excessive Agency"]},
    {"id":"AGENTIR-006","title":"Agent crosses tenant boundary","severity":"critical","conditions":[{"field":"agent.security.tenant.crossing","op":"eq","value":true}],"mitre_atlas":["Lateral Movement","Collection"],"owasp_agentic":["Identity and Privilege Abuse"]},
    {"id":"AGENTIR-007","title":"High-risk action lacks approval","severity":"critical","conditions":[{"field":"agent.security.action.risk","op":"eq","value":"high"},{"field":"agent.security.approval.present","op":"eq","value":false}],"mitre_atlas":["Execution"],"owasp_agentic":["Excessive Agency"]},
    {"id":"AGENTIR-008","title":"Untrusted input precedes privileged tool use","severity":"critical","conditions":[{"field":"agent.security.input.trust","op":"eq","value":"untrusted"},{"field":"agent.security.action.privileged","op":"eq","value":true}],"mitre_atlas":["Execution"],"owasp_agentic":["Prompt Injection"]},
    {"id":"AGENTIR-009","title":"Tool arguments diverge from approved intent","severity":"high","conditions":[{"field":"agent.security.intent.divergence","op":"eq","value":true}],"mitre_atlas":["Execution"],"owasp_agentic":["Goal and Instruction Manipulation"]},
    {"id":"AGENTIR-010","title":"Unregistered MCP tool invoked","severity":"high","conditions":[{"field":"gen_ai.operation.name","op":"eq","value":"execute_tool"},{"field":"agent.security.tool.registered","op":"eq","value":false}],"mitre_atlas":["Execution"],"owasp_agentic":["Tool Misuse"]},
    {"id":"AGENTIR-011","title":"Tool definition changed before invocation","severity":"high","conditions":[{"field":"agent.security.tool.definition_changed","op":"eq","value":true},{"field":"gen_ai.operation.name","op":"eq","value":"execute_tool"}],"mitre_atlas":["Defense Evasion"],"owasp_agentic":["Tool Misuse"]},
    {"id":"AGENTIR-012","title":"Approval bypass attempt","severity":"high","conditions":[{"field":"agent.security.approval.bypass_attempt","op":"eq","value":true}],"mitre_atlas":["Defense Evasion"],"owasp_agentic":["Excessive Agency"]},
    {"id":"AGENTIR-013","title":"Sensitive retrieval followed by external transmission","severity":"critical","conditions":[{"field":"agent.security.data.sensitive","op":"eq","value":true},{"field":"agent.security.destination.external","op":"eq","value":true}],"mitre_atlas":["Exfiltration"],"owasp_agentic":["Data Leakage"]},
    {"id":"AGENTIR-014","title":"Destructive action influenced by retrieved content","severity":"critical","conditions":[{"field":"agent.security.action.reversibility","op":"eq","value":"irreversible"},{"field":"agent.security.input.source","op":"eq","value":"retrieval"}],"mitre_atlas":["Impact"],"owasp_agentic":["Prompt Injection","Excessive Agency"]},
    {"id":"AGENTIR-015","title":"Untrusted content persisted to memory","severity":"high","conditions":[{"field":"agent.security.memory.persisted","op":"eq","value":true},{"field":"agent.security.memory.source_trust","op":"eq","value":"untrusted"}],"mitre_atlas":["Persistence"],"owasp_agentic":["Memory Poisoning"]},
    {"id":"AGENTIR-016","title":"Memory trust label removed","severity":"high","conditions":[{"field":"agent.security.memory.trust_label_removed","op":"eq","value":true}],"mitre_atlas":["Defense Evasion"],"owasp_agentic":["Memory Poisoning"]},
    {"id":"AGENTIR-017","title":"Denied instruction reappears in later session","severity":"high","conditions":[{"field":"agent.security.instruction.previously_denied","op":"eq","value":true},{"field":"agent.security.instruction.replayed","op":"eq","value":true}],"mitre_atlas":["Persistence"],"owasp_agentic":["Memory Poisoning"]},
    {"id":"AGENTIR-018","title":"Agent configuration changed during execution","severity":"high","conditions":[{"field":"agent.security.config.changed","op":"eq","value":true},{"field":"agent.security.session.active","op":"eq","value":true}],"mitre_atlas":["Defense Evasion"],"owasp_agentic":["Unexpected Code Execution"]},
    {"id":"AGENTIR-019","title":"Tool-call fan-out exceeds approved threshold","severity":"medium","conditions":[{"field":"agent.security.tool.fanout","op":"gt","value":20}],"mitre_atlas":["Discovery"],"owasp_agentic":["Cascading Failures"]},
    {"id":"AGENTIR-020","title":"Containment action failed","severity":"critical","conditions":[{"field":"agent.security.containment.action","op":"exists","value":true},{"field":"agent.security.containment.result","op":"eq","value":"failed"}],"mitre_atlas":["Impact"],"owasp_agentic":["Cascading Failures"]}
  ]
}
